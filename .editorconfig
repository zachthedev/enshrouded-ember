root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# The extensions prettier owns here. Prettier reads this file for the options
# .prettierrc leaves unset, so this list has to match the gate's prettier glob.
# A file outside it takes the indent width the [*] section sets.
[*.{md,json,yml,yaml,js,mjs,cjs,ts}]
indent_size = 2

# A markdown line break is two trailing spaces.
[*.md]
trim_trailing_whitespace = false
