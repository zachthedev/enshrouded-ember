# http://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Four spaces where the formatter or the files already use them: Rust
# (rustfmt), TOML (taplo) and Java.
[*.{rs,toml,java}]
indent_size = 4

# A markdown line break is two trailing spaces.
[*.md]
trim_trailing_whitespace = false
