root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# The files prettier owns here, its own configuration file included. Prettier
# reads this file for the options .prettierrc leaves unset, and a file outside
# this section takes the indent width the [*] section sets.
[{*.{md,json,yml,yaml,js,mjs,cjs,ts},.prettierrc}]
indent_size = 2

# A markdown line break is two trailing spaces.
[*.md]
trim_trailing_whitespace = false
