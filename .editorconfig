root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# The extensions prettier owns here. Prettier reads this file, so the gate and
# an editor agree on the width without it being written down twice.
[*.{md,json,yml,yaml,js,mjs,cjs,ts}]
indent_size = 2

# A markdown line break is two trailing spaces.
[*.md]
trim_trailing_whitespace = false
