{
  "name": "enshrouded-ember",
  "private": true,
  "type": "module",
  "description": "The Steam build watcher, the R2 archive client, commit message linting and markup formatting for the Ember repository. The project itself is Rust.",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "audit": "bun audit --audit-level=high",
    "prepare": "bun ./node_modules/lefthook/bin/index.js install",
    "watch-builds": "bun run tools/watch-builds.ts",
    "archive": "bun run tools/archive.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/bun": "1.4.2",
    "lefthook": "2.1.14",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
