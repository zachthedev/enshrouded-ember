{
  "name": "enshrouded-ember-tooling",
  "private": true,
  "type": "module",
  "description": "The Steam build watcher, the R2 archive client, commit message linting and markup formatting for the Ember repository. The project itself is Rust.",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "watch-builds": "bun run tools/watch-builds.ts",
    "archive": "bun run tools/archive.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.4.2",
    "prettier": "3.9.7",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "vdf-parser": "^1.2.1",
    "zod": "^4.6.5"
  }
}
