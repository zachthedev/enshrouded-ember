{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": ["Bash(git status:*)", "PowerShell(git status:*)"],
    "deny": [
      "Edit(//**/SteamLibrary/**)",
      "Edit(//**/steamapps/common/**)",
      "Bash(git diff --output*)",
      "Bash(git diff *--output*)",
      "Bash(git diff --no-index*)",
      "Bash(git diff *--no-index*)",
      "Bash(git log --output*)",
      "Bash(git log *--output*)",
      "Bash(git show --output*)",
      "Bash(git show *--output*)",
      "PowerShell(git diff --output*)",
      "PowerShell(git diff *--output*)",
      "PowerShell(git diff --no-index*)",
      "PowerShell(git diff *--no-index*)",
      "PowerShell(git log --output*)",
      "PowerShell(git log *--output*)",
      "PowerShell(git show --output*)",
      "PowerShell(git show *--output*)"
    ]
  }
}
