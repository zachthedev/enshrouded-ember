# Repository tooling
/node_modules

# SteamCMD, fetched server builds keyed by Steam buildid, and run directories.
/.cache

# Per-machine Claude Code settings, layered over the committed ones, and the
# worktrees the Claude Code CLI creates.
/.claude/settings.local.json
/.claude/worktrees/

# Personal overrides a contributor keeps on their own machine: an env file Bun
# loads, a registry bun install reads, and a lefthook config merged over
# lefthook.yml. The gate refuses a tracked env file or lefthook config. Review
# catches a tracked .npmrc, and the daily audit names its own registry.
.env*
.npmrc
/lefthook-local*
/.lefthook-local*

# Recovered artifacts, never committed. The template below covers *.pdb.
*.BinExport
*.gzf

# Template below: github/gitignore Rust.gitignore at ccf8d89c54f13410f797cb08ac1f39f674d8106e
# Nothing differs from the template.
# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
